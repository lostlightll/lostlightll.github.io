---
import BaseLayout from '../layouts/BaseLayout.astro';

/*
 * 已迁移项目的跳转表（加新项目只改这里）
 *
 * 仓库迁走后，https://lostlightll.github.io/<仓库名>/... 会落到本站的 404，
 * 这里按路径前缀匹配，跳到新地址，子路径、?query、#hash 原样保留。
 *
 * from        旧路径前缀，开头带 "/"，结尾不带 "/"。精确匹配：/nzm-wiki 不会命中 /nzm-wiki2，不区分大小写
 * to          新地址的基础 URL，结尾不带 "/"
 * stripPrefix false → 保留前缀，迁到组织后仍用 github.io：
 *                     /nzm-wiki/a → https://endlessfantasia.github.io/nzm-wiki/a
 *             true  → 去掉前缀，绑了自定义域名：
 *                     /nzm-wiki/a → https://nzm-wiki.com/a
 *
 * 注意：在旧仓库真正迁走前，它自己的 Pages 优先，这里不会生效。
 * 不要在 lostlightll 下再建同名仓库，会破坏 GitHub 对旧仓库地址的自动重定向。
 */
const REDIRECTS = [
    { from: '/nzm-wiki', to: 'https://endlessfantasia.github.io', stripPrefix: false },
    // 组织仓库绑了自定义域名后，可以换成下面这行一步直达：
    // { from: '/nzm-wiki', to: 'https://nzm-wiki.com', stripPrefix: true },
];
---

<BaseLayout title="404" description="这一页还没画出来。">
    <Fragment slot="head">
        <meta name="robots" content="noindex">
        <script define:vars={{ redirects: REDIRECTS }}>
            const path = location.pathname;
            const lower = path.toLowerCase();
            const rule = [...redirects]
                .sort((a, b) => b.from.length - a.from.length)
                .find((r) => {
                    const key = r.from.replace(/\/+$/, '').toLowerCase();
                    return lower === key || lower.startsWith(key + '/');
                });

            if (rule) {
                const from = rule.from.replace(/\/+$/, '');
                const rest = (rule.stripPrefix ? path.slice(from.length) : path) || '/';
                location.replace(rule.to.replace(/\/+$/, '') + rest + location.search + location.hash);
            }
        </script>
    </Fragment>

    <section class="lost shell">
        <div class="lost-panel panel">
            <div class="speedlines" aria-hidden="true"></div>
            <p class="lost-code" aria-hidden="true">404</p>
            <h1 class="lost-title">这一页还没画出来</h1>
            <p class="lost-text">也许它在下一话里。</p>
            <a class="lost-back" href="/#contents">回到目录 →</a>
        </div>
    </section>
</BaseLayout>

<style>
    .lost {
        padding-top: clamp(32px, 6vw, 72px);
    }

    .lost-panel {
        display: grid;
        justify-items: center;
        gap: 14px;
        padding: clamp(48px, 9vw, 110px) 24px;
        overflow: hidden;
        text-align: center;
        box-shadow: var(--shadow-lg);
    }

    .lost-code {
        color: transparent;
        font-family: var(--font-display);
        font-size: clamp(7rem, 26vw, 15rem);
        line-height: 0.9;
        -webkit-text-stroke: 3px var(--ink);
        text-shadow: 0.05em 0.05em 0 var(--accent);
    }

    .lost-title {
        font-size: clamp(2rem, 5vw, 3.2rem);
    }

    .lost-text {
        color: var(--muted);
    }

    .lost-back {
        margin-top: 18px;
        padding: 0.6em 1.4em;
        border: var(--border);
        background: var(--ink);
        color: var(--paper);
        font-family: var(--font-display);
        font-size: 1.2rem;
        text-decoration: none;
        box-shadow: 5px 5px 0 var(--accent);
        transition: transform 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out);
    }

    .lost-back:hover {
        transform: translate(-3px, -3px);
        box-shadow: 8px 8px 0 var(--accent);
    }
</style>
