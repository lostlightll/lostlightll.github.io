---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterCard from '../components/ChapterCard.astro';
import avatar from '../assets/avatar.jpg';
import { formatDate, getChapters, groupByYear } from '../utils/posts';

const chapters = await getChapters();
const volumes = groupByYear(chapters);
const latest = chapters[0];
const titleLines = [[...'幻想'], [...'延续']];
---

<BaseLayout>
    <section class="hero shell">
        <div class="cover panel">
            <div class="speedlines" aria-hidden="true"></div>
            <p class="kicker cover-kicker">Vol.01 · 个人连载 · Since 2026</p>
            <h1 class="cover-title" aria-label="幻想延续">
                {titleLines.map((line, row) => (
                    <span class="cover-line" aria-hidden="true">
                        {line.map((char, col) => <span class="cover-char" style={`--i: ${row * 2 + col}`}>{char}</span>)}
                    </span>
                ))}
            </h1>
            <p class="cover-sub">To be continued<span aria-hidden="true"> ——</span></p>
            <span class="stamp cover-stamp">连载中</span>
            <dl class="cover-stats">
                <div><dt>已连载</dt><dd>{chapters.length} 话</dd></div>
                {latest && <div><dt>最近更新</dt><dd>{formatDate(latest.post.data.date)}</dd></div>}
                <div><dt>作者</dt><dd>幻想</dd></div>
            </dl>
        </div>
        <a class="character panel" href="/about/">
            <span class="character-tone tone" aria-hidden="true"></span>
            <p class="bubble character-bubble">Student, occasional developer.</p>
            <Image class="character-img" src={avatar} alt="幻想的头像" quality={80} loading="eager" />
            <p class="character-name">幻想 <span>@lostlightll</span></p>
        </a>
    </section>

    <section id="contents" class="contents shell" aria-labelledby="contents-title">
        <header class="contents-head">
            <h2 id="contents-title">目录</h2>
            <p class="kicker">Contents · 共 {chapters.length} 话</p>
        </header>
        {volumes.map(([year, list], v) => (
            <div class="volume">
                <p class="volume-year" aria-label={`${year} 年`}>{year}</p>
                <ol class="chapters">
                    {list.map((chapter, i) => <ChapterCard chapter={chapter} featured={v === 0 && i === 0} />)}
                </ol>
            </div>
        ))}
        {chapters.length === 0 && <p class="empty">第一话正在绘制中……</p>}
    </section>
</BaseLayout>

<style>
    .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
        align-items: center;
        gap: 0;
        padding-block: clamp(28px, 5vw, 64px) clamp(56px, 8vw, 96px);
    }

    .cover {
        --focus-x: 68%;
        --focus-y: 42%;
        display: flex;
        flex-direction: column;
        gap: 18px;
        min-height: clamp(460px, 62vh, 640px);
        padding: clamp(24px, 4.5vw, 56px);
        overflow: hidden;
        box-shadow: var(--shadow-lg);
    }

    .cover-title {
        display: flex;
        flex-direction: column;
        margin-block: auto;
        color: var(--ink);
        font-family: var(--font-title);
        font-weight: 900;
        font-size: clamp(5rem, 13.5vw, 11.5rem);
        line-height: 1.04;
        letter-spacing: -0.04em;
    }

    .cover-line:last-child {
        padding-left: 0.9em;
    }

    .cover-char {
        display: inline-block;
        text-shadow: 0.055em 0.055em 0 var(--accent);
    }

    .cover-sub {
        color: var(--ink);
        font-family: var(--font-display);
        font-size: clamp(1.2rem, 2.2vw, 1.6rem);
        letter-spacing: 0.04em;
    }

    .cover-stamp {
        position: absolute;
        top: clamp(20px, 4vw, 44px);
        right: clamp(20px, 6vw, 84px);
        font-size: clamp(1.1rem, 2vw, 1.5rem);
        transform: rotate(9deg);
    }

    .cover-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 0;
        padding-top: 18px;
        border-top: 2px solid var(--ink);
        font-family: var(--font-mono);
        font-size: 0.8rem;
    }

    .cover-stats div {
        display: flex;
        gap: 8px;
        padding-inline: 18px;
        border-left: 2px solid var(--ink);
    }

    .cover-stats div:first-child {
        padding-left: 0;
        border-left: 0;
    }

    .cover-stats dt {
        color: var(--muted);
    }

    .cover-stats dd {
        color: var(--ink);
    }

    .character {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-left: -36px;
        padding: 26px 24px 20px;
        color: inherit;
        text-decoration: none;
        box-shadow: var(--shadow);
        transform: rotate(2.2deg);
        transition: transform 0.5s var(--ease-slam), box-shadow 0.4s var(--ease-out);
    }

    .character:hover {
        transform: rotate(0deg) translate(-4px, -6px);
        box-shadow: var(--shadow-lg);
    }

    .character-tone {
        --tone-size: 6px;
        position: absolute;
        inset: 0;
        z-index: -1;
        mask-image: linear-gradient(160deg, transparent 35%, #000 100%);
    }

    .character-bubble {
        align-self: flex-start;
        margin-bottom: 8px;
        font-size: 1.05rem;
    }

    .character-img {
        width: 100%;
        aspect-ratio: 1;
        object-fit: cover;
        border: var(--border);
        filter: grayscale(1) contrast(1.08);
    }

    .character-name {
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 1.6rem;
        line-height: 1.2;
    }

    .character-name span {
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 0.85rem;
    }

    .contents-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px 24px;
        margin-bottom: 36px;
        padding-bottom: 14px;
        border-bottom: 6px double var(--ink);
    }

    .contents-head h2 {
        font-size: clamp(2.6rem, 6vw, 4rem);
        line-height: 1;
    }

    .volume {
        display: grid;
        grid-template-columns: 72px minmax(0, 1fr);
        gap: 28px;
    }

    .volume + .volume {
        margin-top: 56px;
    }

    .volume-year {
        position: sticky;
        top: 96px;
        align-self: start;
        color: transparent;
        font-family: var(--font-display);
        font-size: 4.2rem;
        line-height: 1;
        writing-mode: vertical-rl;
        -webkit-text-stroke: 2px var(--ink);
    }

    .chapters {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
        gap: 22px;
        margin: 0;
        padding: 0;
    }

    .chapters :global(.featured) {
        grid-column: 1 / -1;
    }

    .empty {
        color: var(--muted);
        font-family: var(--font-display);
        font-size: 1.4rem;
    }

    @media (prefers-reduced-motion: no-preference) {
        .cover-char {
            animation: slam 0.7s var(--ease-slam) backwards;
            animation-delay: calc(var(--i) * 110ms + 120ms);
        }

        .cover-stamp {
            animation: stamp 0.45s var(--ease-slam) 0.75s backwards;
        }

        .cover .speedlines {
            animation: burst 1.1s var(--ease-out) backwards;
        }

        .character {
            animation: slide-in 0.8s var(--ease-slam) 0.35s backwards;
        }
    }

    @keyframes slam {
        from {
            opacity: 0;
            transform: scale(2.4) rotate(-10deg);
            filter: blur(8px);
        }
    }

    @keyframes stamp {
        from {
            opacity: 0;
            transform: scale(3) rotate(-20deg);
        }
    }

    @keyframes burst {
        from {
            opacity: 0;
            transform: scale(1.35);
        }
    }

    @keyframes slide-in {
        from {
            opacity: 0;
            transform: translateX(60px) rotate(9deg);
        }
    }

    @media (max-width: 860px) {
        .hero {
            grid-template-columns: minmax(0, 1fr);
            gap: 40px;
        }

        .cover {
            min-height: 0;
        }

        .cover-kicker {
            padding-right: 64px;
        }

        .cover-title {
            margin-block: 32px 8px;
            font-size: min(25vw, 9rem);
        }

        .character {
            width: min(100%, 360px);
            margin: 0 auto;
            transform: rotate(1.5deg);
        }

        .volume {
            grid-template-columns: minmax(0, 1fr);
            gap: 12px;
        }

        .volume-year {
            position: static;
            font-size: 2.8rem;
            writing-mode: horizontal-tb;
        }
    }
</style>
