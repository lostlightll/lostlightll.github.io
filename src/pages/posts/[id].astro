---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getChapters, type Chapter } from '../../utils/posts';

interface Props {
    chapter: Chapter;
    older?: Chapter;
    newer?: Chapter;
}

export async function getStaticPaths() {
    const chapters = await getChapters();
    return chapters.map((chapter, i) => ({
        params: { id: chapter.post.id },
        props: { chapter, newer: chapters[i - 1], older: chapters[i + 1] },
    }));
}

const { chapter, older, newer } = Astro.props;
const { post, label, minutes } = chapter;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} progress>
    <article class="episode shell">
        <header class="episode-head panel">
            <div class="speedlines" aria-hidden="true"></div>
            <p class="episode-no">第<b>{label}</b>话</p>
            <h1 class="episode-title vt-title" style={`view-transition-name: chapter-${chapter.no}`}>{post.data.title}</h1>
            {post.data.description && <p class="episode-desc">{post.data.description}</p>}
            <p class="episode-meta">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <span>约 {minutes} 分钟</span>
                {post.data.tags.map((tag) => <span>#{tag}</span>)}
            </p>
        </header>

        <div class="prose episode-body">
            <Content />
        </div>

        <footer class="episode-end">
            <p class="end-mark"><span>本话完</span></p>
            <nav class="episode-nav" aria-label="章节导航">
                {older ? (
                    <a class="episode-link panel" href={older.href} rel="prev">
                        <span class="kicker">← 上一话 · 第 {older.label} 话</span>
                        <span class="episode-link-title">{older.post.data.title}</span>
                    </a>
                ) : (
                    <p class="episode-link episode-link-empty panel"><span class="kicker">这是第一话</span><span class="episode-link-title">故事从这里开始</span></p>
                )}
                {newer ? (
                    <a class="episode-link panel" href={newer.href} rel="next">
                        <span class="kicker">下一话 · 第 {newer.label} 话 →</span>
                        <span class="episode-link-title">{newer.post.data.title}</span>
                    </a>
                ) : (
                    <p class="episode-link episode-link-empty panel"><span class="kicker">已是最新一话</span><span class="episode-link-title">下一话，绘制中……</span></p>
                )}
            </nav>
        </footer>
    </article>
</BaseLayout>

<style>
    .episode {
        padding-top: clamp(28px, 5vw, 56px);
    }

    .episode-head {
        --focus-x: 82%;
        --focus-y: 30%;
        --lines-opacity: 0.11;
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: clamp(28px, 5vw, 60px);
        overflow: hidden;
        box-shadow: var(--shadow-lg);
    }

    .episode-no {
        color: var(--accent-ink);
        font-family: var(--font-display);
        font-size: 1.25rem;
        letter-spacing: 0.1em;
    }

    .episode-no b {
        margin-inline: 0.2em;
        font-size: 2.2em;
        font-weight: 400;
        line-height: 1;
    }

    .episode-title {
        max-width: 18em;
        font-size: clamp(2.4rem, 6.5vw, 4.8rem);
        text-wrap: balance;
    }

    .episode-desc {
        max-width: 40em;
        color: var(--ink-2);
        font-size: 1.1rem;
    }

    .episode-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 18px;
        margin-top: 8px;
        padding-top: 14px;
        border-top: 2px solid var(--ink);
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 0.8rem;
    }

    .episode-body {
        max-width: 42rem;
        margin: clamp(40px, 6vw, 72px) auto 0;
    }

    .episode-end {
        max-width: 54rem;
        margin: clamp(56px, 8vw, 96px) auto 0;
    }

    .end-mark {
        display: flex;
        align-items: center;
        gap: 20px;
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 1.4rem;
        letter-spacing: 0.3em;
    }

    .end-mark::before,
    .end-mark::after {
        content: "";
        flex: 1;
        height: 3px;
        background: var(--ink);
    }

    .episode-nav {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
        gap: 20px;
        margin-top: 36px;
    }

    .episode-link {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 20px 24px;
        color: inherit;
        text-decoration: none;
        transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
    }

    a.episode-link:hover {
        transform: translate(-4px, -4px);
        box-shadow: var(--shadow);
    }

    a.episode-link[rel="next"] {
        text-align: right;
    }

    .episode-link-title {
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 1.35rem;
    }

    .episode-link-empty {
        border-style: dashed;
        opacity: 0.7;
    }

    @media (prefers-reduced-motion: no-preference) {
        .episode-head .speedlines {
            animation: burst 1s var(--ease-out) backwards;
        }
    }

    @keyframes burst {
        from {
            opacity: 0;
            transform: scale(1.3);
        }
    }
</style>
