---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import avatar from '../assets/avatar.jpg';
import { formatDate, getChapters } from '../utils/posts';

const chapters = await getChapters();
const first = chapters.at(-1);

const stats = [
    { label: '身份', value: 'Student' },
    { label: '属性', value: 'Occasional developer' },
    { label: '搭档', value: '@Sh4ck1e', href: 'https://github.com/Sh4ck1e' },
    { label: '据点', value: 'github.com/lostlightll', href: 'https://github.com/lostlightll' },
    { label: '登场', value: first ? `${formatDate(first.post.data.date)} · 第 ${first.label} 话` : '即将登场' },
];
---

<BaseLayout title="作者" description="角色档案：幻想 / lostlightll">
    <section class="profile shell">
        <div class="profile-art panel">
            <div class="speedlines" aria-hidden="true"></div>
            <span class="profile-tone tone" aria-hidden="true"></span>
            <p class="kicker profile-file">Character File · No.001</p>
            <Image class="profile-img" src={avatar} alt="幻想的头像" quality={80} loading="eager" />
            <span class="stamp profile-stamp">主角</span>
        </div>

        <div class="profile-body">
            <p class="kicker">角色档案 / Character</p>
            <h1 class="profile-name">幻想</h1>
            <p class="profile-id">@lostlightll</p>
            <p class="bubble profile-bubble">There should be a personal signature here.</p>
            <dl class="profile-stats">
                {stats.map((stat) => (
                    <div>
                        <dt>{stat.label}</dt>
                        <dd>{stat.href ? <a href={stat.href}>{stat.value}</a> : stat.value}</dd>
                    </div>
                ))}
            </dl>
        </div>
    </section>
</BaseLayout>

<style>
    .profile {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        align-items: center;
        gap: clamp(40px, 6vw, 88px);
        padding-top: clamp(32px, 6vw, 72px);
    }

    .profile-art {
        --focus-x: 50%;
        --focus-y: 45%;
        padding: clamp(24px, 4vw, 40px);
        overflow: hidden;
        box-shadow: var(--shadow-lg);
        transform: rotate(-1.8deg);
    }

    .profile-tone {
        --tone-size: 7px;
        position: absolute;
        inset: 0;
        z-index: -1;
        mask-image: linear-gradient(to top, #000, transparent 65%);
    }

    .profile-file {
        margin-bottom: 18px;
    }

    .profile-img {
        width: 100%;
        aspect-ratio: 1;
        object-fit: cover;
        border: var(--border);
        filter: grayscale(1) contrast(1.1);
    }

    .profile-stamp {
        position: absolute;
        right: 20px;
        bottom: 22px;
        background: var(--paper);
        font-size: 1.4rem;
        transform: rotate(-8deg);
    }

    .profile-body {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .profile-name {
        font-size: clamp(5rem, 12vw, 9rem);
        line-height: 0.95;
        text-shadow: 0.05em 0.05em 0 var(--accent);
    }

    .profile-id {
        color: var(--muted);
        font-family: var(--font-mono);
        letter-spacing: 0.08em;
    }

    .profile-bubble {
        align-self: flex-start;
        margin-block: 22px 34px;
        font-size: 1.15rem;
    }

    .profile-stats {
        border-top: var(--border);
    }

    .profile-stats div {
        display: grid;
        grid-template-columns: 5em minmax(0, 1fr);
        gap: 16px;
        padding-block: 12px;
        border-bottom: 2px solid var(--ink);
    }

    .profile-stats dt {
        color: var(--accent-ink);
        font-family: var(--font-display);
        font-size: 1.1rem;
        letter-spacing: 0.2em;
    }

    .profile-stats dd {
        color: var(--ink);
        overflow-wrap: anywhere;
    }

    .profile-stats a:hover {
        color: var(--accent-ink);
    }

    @media (prefers-reduced-motion: no-preference) {
        .profile-art {
            animation: drop 0.8s var(--ease-slam) backwards;
        }

        .profile-stamp {
            animation: stamp 0.45s var(--ease-slam) 0.6s backwards;
        }
    }

    @keyframes drop {
        from {
            opacity: 0;
            transform: translateY(-40px) rotate(-8deg);
        }
    }

    @keyframes stamp {
        from {
            opacity: 0;
            transform: scale(3) rotate(-25deg);
        }
    }

    @media (max-width: 860px) {
        .profile {
            grid-template-columns: minmax(0, 1fr);
        }

        .profile-art {
            width: min(100%, 420px);
            margin-inline: auto;
        }
    }
</style>
