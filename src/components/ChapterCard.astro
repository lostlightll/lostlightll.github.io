---
import { formatDate, type Chapter } from '../utils/posts';

interface Props {
    chapter: Chapter;
    featured?: boolean;
}

const { chapter, featured = false } = Astro.props;
const { post, label, minutes, href } = chapter;
---

<li class:list={['chapter', { featured }]}>
    <a class="chapter-link panel" href={href}>
        <span class="chapter-tone tone" aria-hidden="true"></span>
        <span class="chapter-no" aria-hidden="true">{label}</span>
        <p class="chapter-kicker">
            第 {label} 话{featured && <span class="chapter-new">最新</span>}
        </p>
        <h3 class="chapter-title vt-title" style={`view-transition-name: chapter-${chapter.no}`}>{post.data.title}</h3>
        {post.data.description && <p class="chapter-desc">{post.data.description}</p>}
        <p class="chapter-meta">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <span>约 {minutes} 分钟</span>
            {post.data.tags.map((tag) => <span>#{tag}</span>)}
            {post.data.draft && <span class="chapter-draft">草稿</span>}
        </p>
    </a>
</li>

<style>
    .chapter {
        list-style: none;
    }

    .chapter-link {
        display: flex;
        flex-direction: column;
        gap: 10px;
        height: 100%;
        min-height: 230px;
        padding: 26px 28px 24px;
        overflow: hidden;
        color: inherit;
        text-decoration: none;
        transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
    }

    .chapter-link:hover,
    .chapter-link:focus-visible {
        transform: translate(-5px, -5px) rotate(-0.4deg);
        box-shadow: var(--shadow-lg);
    }

    .chapter-tone {
        --tone-size: 8px;
        position: absolute;
        inset: auto -10% -30% 35%;
        height: 80%;
        z-index: -1;
        mask-image: radial-gradient(ellipse at 100% 100%, #000 10%, transparent 70%);
        transition: --tone-size 0.6s var(--ease-out);
    }

    .chapter-link:hover .chapter-tone {
        --tone-size: 11px;
    }

    .chapter-no {
        position: absolute;
        top: -0.12em;
        right: 0.08em;
        z-index: -1;
        color: transparent;
        font-family: var(--font-display);
        font-size: 7.5rem;
        line-height: 1;
        -webkit-text-stroke: 2px var(--ink);
        opacity: 0.85;
        transition: color 0.35s var(--ease-out), transform 0.5s var(--ease-slam);
    }

    .chapter-link:hover .chapter-no {
        color: var(--accent);
        -webkit-text-stroke-color: var(--accent);
        transform: scale(1.08) rotate(-4deg);
    }

    .chapter-kicker {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--accent-ink);
        font-family: var(--font-display);
        font-size: 1rem;
        letter-spacing: 0.08em;
    }

    .chapter-new {
        padding: 0.1em 0.6em;
        background: var(--accent);
        color: var(--on-accent);
        font-size: 0.8rem;
        letter-spacing: 0.1em;
        transform: rotate(-3deg);
    }

    .chapter-title {
        max-width: 85%;
        font-size: clamp(1.7rem, 3vw, 2.1rem);
        text-wrap: balance;
    }

    .chapter-desc {
        max-width: 85%;
        color: var(--ink-2);
    }

    .chapter-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 16px;
        margin-top: auto;
        padding-top: 14px;
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 0.78rem;
    }

    .chapter-draft {
        color: var(--accent-ink);
    }

    .featured .chapter-link {
        min-height: 320px;
        padding: clamp(28px, 4vw, 48px);
        box-shadow: var(--shadow);
    }

    .featured .chapter-no {
        font-size: clamp(9rem, 22vw, 16rem);
    }

    .featured .chapter-title {
        font-size: clamp(2.3rem, 5.5vw, 4rem);
    }

    .featured .chapter-desc {
        font-size: 1.1rem;
    }

    @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
            .chapter {
                animation: panel-in linear both;
                animation-timeline: view();
                animation-range: entry 0% entry 70%;
            }
        }
    }

    @keyframes panel-in {
        from {
            opacity: 0;
            transform: translateY(48px) rotate(-1.2deg);
        }
    }
</style>
