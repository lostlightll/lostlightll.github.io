---
interface Props {
    active: 'home' | 'about';
    subtitle: string;
}

const { active, subtitle } = Astro.props;
---

<header class="site-header">
    <div class="wrap">
        <a class="site-name" href="/">幻想<span>{subtitle}</span></a>
        <nav>
            <a class:list={{ active: active === 'home' }} href="/">首页</a>
            <a class:list={{ active: active === 'about' }} href="/about/">关于</a>
        </nav>
        <div class="clear"></div>
    </div>
</header>
